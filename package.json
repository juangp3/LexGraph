{
  "name": "lexgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:backend": "npm run dev",
    "dev:frontend": "cd web && npm run dev",
    "dev:full": "npx concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "start": "node dist/src/server.js",
    "start:full": "tsx scripts/ensure-docker.ts && npm run infra:up && npm run dev:full",
    "stop:full": "npm run infra:down",
    "db:migrate": "prisma migrate deploy",
    "db:seed:week2": "tsx scripts/seed-week2.ts",
    "import:data": "tsx scripts/import-week4.ts",
    "seed:v2": "tsx scripts/seed-v2.ts",
    "resume:import": "tsx scripts/resume-import.ts",
    "report:import-status": "tsx scripts/report-import-status.ts",
    "infra:doctor": "docker context ls && docker context show && docker --context default version",
    "infra:up": "docker compose up -d postgres apache-age redis",
    "infra:down": "docker compose down",
    "infra:full": "docker compose up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "db:restore:drill": "tsx scripts/db/restore-drill.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:functional": "vitest run tests/functional",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:performance:search": "k6 run tests/performance/search-smoke.js",
    "test:performance:word": "k6 run tests/performance/word-lookup-smoke.js",
    "test:performance:traversal": "k6 run tests/performance/traversal-smoke.js",
    "test:performance": "npm run test:performance:search && npm run test:performance:word && npm run test:performance:traversal",
    "benchmark:search": "tsx scripts/run-search-benchmark.ts",
    "test:fast": "npm run test:unit && npm run test:component && npm run test:functional",
    "test:all": "npm run test:fast && npm run test:integration && npm run test:system",
    "integrity:check": "tsx scripts/check-integrity.ts",
    "perf:graph": "npx tsx scripts/perf/run-graph-perf.ts",
    "perf:api": "tsx scripts/perf/run-api-bench.ts",
    "perf:api:regression": "tsx scripts/perf/check-api-regression.ts",
    "perf:ci": "tsx scripts/perf/run-ci-perf.ts",
    "perf:dataset": "tsx scripts/perf/generate-benchmark-dataset.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "msw": "^2.15.0",
    "prisma": "^6.11.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
