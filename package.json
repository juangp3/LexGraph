{
  "name": "lexgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed:week2": "tsx scripts/seed-week2.ts",
    "import:week4": "tsx scripts/import-week4.ts",
    "infra:doctor": "docker context ls && docker context show && docker --context default version",
    "infra:up": "docker compose up -d postgres apache-age redis",
    "infra:down": "docker compose down",
    "infra:full": "docker compose up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:functional": "vitest run tests/functional",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:performance:search": "k6 run tests/performance/search-smoke.js",
    "test:performance:traversal": "k6 run tests/performance/traversal-smoke.js",
    "test:performance": "npm run test:performance:search && npm run test:performance:traversal",
    "test:fast": "npm run test:unit && npm run test:component && npm run test:functional",
    "test:all": "npm run test:fast && npm run test:integration && npm run test:system",
    "integrity:check": "tsx scripts/check-integrity.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "express": "^4.19.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.11.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
