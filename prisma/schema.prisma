generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LanguageFamily {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  slug           String           @unique
  parentFamilyId String?          @map("parent_family_id") @db.Uuid
  parentFamily   LanguageFamily?  @relation("FamilyHierarchy", fields: [parentFamilyId], references: [id], onDelete: SetNull)
  childFamilies  LanguageFamily[] @relation("FamilyHierarchy")
  languages      Language[]
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([parentFamilyId])
  @@map("language_families")
}

model Language {
  id          String          @id @default(uuid()) @db.Uuid
  familyId    String?         @map("family_id") @db.Uuid
  family      LanguageFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  name        String
  iso6393     String?         @map("iso639_3")
  stageLabel  String?         @map("stage_label")
  periodStart Int?            @map("period_start")
  periodEnd   Int?            @map("period_end")
  words       Word[]
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([name, stageLabel], map: "uq_languages_name_stage_label")
  @@index([familyId])
  @@index([iso6393])
  @@map("languages")
}

model Source {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  author      String?
  year        Int?
  url         String?
  license     String?
  citation    String?
  wordSources WordSource[]
  edgeSources EdgeSource[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([year])
  @@map("sources")
}

model ImportJob {
  id               String            @id @default(uuid()) @db.Uuid
  sourceName       String?           @map("source_name")
  status           String            @default("QUEUED")
  rejectionLogPath String?           @map("rejection_log_path")
  processedCount   Int               @default(0) @map("processed_count")
  acceptedCount    Int               @default(0) @map("accepted_count")
  rejectedCount    Int               @default(0) @map("rejected_count")
  upsertedWords    Int               @default(0) @map("upserted_words")
  upsertedEdges    Int               @default(0) @map("upserted_edges")
  summary          Json?             @db.JsonB
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  rawImportRecords RawImportRecord[]

  @@index([status])
  @@map("import_jobs")
}

model RawImportRecord {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceKey  String    @map("source_key")
  sourceHash String    @map("source_hash")
  payload    Json      @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobId])
  @@index([sourceHash])
  @@map("raw_import_records")
}

model Word {
  id                   String          @id @default(uuid()) @db.Uuid
  languageId           String          @map("language_id") @db.Uuid
  language             Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  textOriginal         String          @map("text_original")
  textNormalized       String          @map("text_normalized")
  textAsciiFolded      String          @map("text_ascii_folded")
  lemma                String?
  ipa                  String?
  isReconstructed      Boolean         @default(false) @map("is_reconstructed")
  reconstructionMarker String?         @map("reconstruction_marker")
  periodLabel          String?         @map("period_label")
  notes                String?
  meanings             Meaning[]
  wordSources          WordSource[]
  outgoingEdges        EtymologyEdge[] @relation("OutgoingWordEdges")
  incomingEdges        EtymologyEdge[] @relation("IncomingWordEdges")
  savedWords           SavedWord[]
  savedGraphs          SavedGraph[]
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([languageId, textNormalized, lemma], map: "uq_words_prisma_compat")
  @@index([languageId])
  @@index([isReconstructed])
  @@map("words")
}

model Meaning {
  id        String   @id @default(uuid()) @db.Uuid
  wordId    String   @map("word_id") @db.Uuid
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  gloss     String
  domain    String?
  usageNote String?  @map("usage_note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([wordId])
  @@map("meanings")
}

model WordSource {
  id              String   @id @default(uuid()) @db.Uuid
  wordId          String   @map("word_id") @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  word            Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceLocator   String?  @map("source_locator")
  extractedBy     String?  @map("extracted_by")
  confidence      Decimal  @default(1.00) @db.Decimal(3, 2)
  evidenceSummary String?  @map("evidence_summary")
  conflictType    String?  @map("conflict_type")
  conflictDetails String?  @map("conflict_details")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([wordId, sourceId, sourceLocator], map: "uq_word_sources_prisma_compat")
  @@index([sourceId])
  @@map("word_sources")
}

model EtymologyEdge {
  id              String       @id @default(uuid()) @db.Uuid
  fromWordId      String       @map("from_word_id") @db.Uuid
  toWordId        String       @map("to_word_id") @db.Uuid
  relationType    String       @map("relation_type")
  confidence      Decimal      @db.Decimal(3, 2)
  evidenceSummary String?      @map("evidence_summary")
  method          String
  isDisputed      Boolean      @default(false) @map("is_disputed")
  createdBy       String?      @map("created_by")
  conflictType    String?      @map("conflict_type")
  conflictDetails String?      @map("conflict_details")
  fromWord        Word         @relation("OutgoingWordEdges", fields: [fromWordId], references: [id], onDelete: Cascade)
  toWord          Word         @relation("IncomingWordEdges", fields: [toWordId], references: [id], onDelete: Cascade)
  edgeSources     EdgeSource[]
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([fromWordId, toWordId, relationType], map: "uq_etymology_edges_from_to_type")
  @@index([toWordId, relationType])
  @@index([relationType])
  @@map("etymology_edges")
}

model EdgeSource {
  id              String        @id @default(uuid()) @db.Uuid
  edgeId          String        @map("edge_id") @db.Uuid
  sourceId        String        @map("source_id") @db.Uuid
  sourceLocator   String?       @map("source_locator")
  quoteExcerpt    String?       @map("quote_excerpt")
  confidenceDelta Decimal?      @map("confidence_delta") @db.Decimal(3, 2)
  edge            EtymologyEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  source          Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([edgeId, sourceId, sourceLocator], map: "uq_edge_sources_edge_source_locator")
  @@index([sourceId])
  @@map("edge_sources")
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  passwordHash  String          @map("password_hash")
  displayName   String?         @map("display_name")
  avatarUrl     String?         @map("avatar_url")
  status        String          @default("ACTIVE")
  lastLoginAt   DateTime?       @map("last_login_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions      UserSession[]
  providerLinks ProviderLink[]
  preferences   UserPreference?
  savedWords    SavedWord[]
  collections   Collection[]
  savedGraphs   SavedGraph[]
  notes         Note[]
  searchHistory SearchHistory[]
  recentViews   RecentView[]

  @@index([status])
  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserPreference {
  userId            String   @id @map("user_id") @db.Uuid
  theme             String   @default("system")
  interfaceLanguage String   @default("en") @map("interface_language")
  defaultGraphDepth Int      @default(3) @map("default_graph_depth")
  graphLayout       String   @default("hierarchical") @map("graph_layout")
  showMeanings      Boolean  @default(true) @map("show_meanings")
  showSources       Boolean  @default(true) @map("show_sources")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ProviderLink {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "uq_provider_links_provider_providerUserId")
  @@index([userId])
  @@map("provider_links")
}

model SavedWord {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  wordId      String                @map("word_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  word        Word                  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  collections CollectionSavedWord[]

  @@unique([userId, wordId], map: "uq_saved_words_user_word")
  @@index([userId])
  @@index([userId, createdAt])
  @@map("saved_words")
}

model Collection {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  name        String
  description String?
  position    Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionSavedWord[]

  @@unique([userId, name], map: "uq_collections_user_name")
  @@index([userId])
  @@map("collections")
}

model CollectionSavedWord {
  collectionId String     @map("collection_id") @db.Uuid
  savedWordId  String     @map("saved_word_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedWord    SavedWord  @relation(fields: [savedWordId], references: [id], onDelete: Cascade)

  @@id([collectionId, savedWordId])
  @@map("collection_saved_words")
}

model SavedGraph {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  rootEntityId     String   @map("root_entity_id") @db.Uuid
  title            String
  depth            Int      @default(3)
  filters          Json     @db.JsonB
  layoutPreference String?  @map("layout_preference")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootEntity       Word     @relation(fields: [rootEntityId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("saved_graphs")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("notes")
}

model SearchHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  query      String
  searchedAt DateTime @default(now()) @map("searched_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@map("search_history")
}

model RecentView {
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entityType, entityId])
  @@index([userId, viewedAt])
  @@map("recent_views")
}
