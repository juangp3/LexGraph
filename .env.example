# API service runtime
DATABASE_URL=postgresql://lexgraph:lexgraph@localhost:5433/lexgraph
PORT=3001

# CORS allowlist for frontend origins (use either FRONTEND_URL or FRONTEND_URLS)
# Local development:
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# Production (set these as environment variables on your deployment, never commit real values):
# FRONTEND_URL=https://lexgraph.vercel.app
# FRONTEND_URLS=https://lexgraph.vercel.app,https://lexgraph.duckdns.org

# Deployment and hardening
GRAPH_MAX_DEPTH=4
GRAPH_MAX_NODES=500
GRAPH_MAX_EDGES=1000
GRAPH_MAX_LIMIT=100
API_QUERY_TIMEOUT_MS=2000
GRAPH_QUERY_TIMEOUT_MS=4000
SESSION_COOKIE_NAME=lexgraph_auth
SESSION_SECRET=change-me-in-production

# Test switches
RUN_INTEGRATION=false
